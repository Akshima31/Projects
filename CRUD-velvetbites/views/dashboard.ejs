<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;800&display=swap" rel="stylesheet">
 <style>

:root {
    --bg-color: linear-gradient(150deg, rgb(61, 60, 60) , rgb(80, 76, 76) , rgb(100, 95, 95));
            --surface-color: rgb(43, 33, 33);
            --text-primary: #f8fafc;
            --text-secondary: wheat;
            --accent: rgba(214, 83, 133, 0.918);
            --accent-hover: rgba(226, 63, 172, 0.836);
            --border: rgba(214, 83, 133, 0.918);
}

 *{
            margin:0;
            padding:0;
            box-sizing:border-box;
        }

        body{
            font-family:'Inter', sans-serif;
            background: var(--bg-color);
            color: var(--text-primary);
        }




/* HEADER */

        header{
            width:100%;
            padding:20px 80px;
            display:flex;
            justify-content:space-between;
            align-items:center;
            border-bottom:1px solid var(--border);
            background: rgba(0,0,0,0.4);
            backdrop-filter: blur(10px);
            position:sticky;
            top:0;
            z-index:100;
        }

        .logo{
            font-size:2rem;
            font-weight:800;
            color: var(--accent);
            font-family: Arial, Helvetica, sans-serif;
        }

        nav ul{
            display:flex;
            list-style:none;
            gap:30px;
        }

        button{
            padding:14px 30px;
            border:none;
            border-radius:10px;
            background: var(--accent);
            color:white;
            font-weight:600;
            cursor:pointer;
            transition:0.3s;
        }

        button:hover{
            background: var(--accent-hover);
            transform: translateY(-2px);
        }
/* OVERVIEW */

.overview{
    display:grid;
    grid-template-columns: repeat(4, 1fr);
    gap:25px;
    margin-bottom:50px;
    margin-top: 30px;
}

.overview-card{
    background: var(--surface-color);
    border:1px solid var(--border);
    border-radius:20px;
    padding:30px;
    text-align:center;
    box-shadow: 0 4px 30px rgba(12, 12, 12, 0.911);
}

.overview-card h2{
    color: var(--accent);
    margin-bottom:10px;
}

.overview-card p{
    font-size:28px;
    font-weight:700;
}

/* MANAGEMENT */

.management-grid{
    display:grid;
    grid-template-columns: repeat(2, 1fr);
    gap:30px;
}

.management-card{
    background: var(--surface-color);
    border:1px solid var(--border);
    border-radius:20px;
    padding:40px;
    box-shadow: 0 4px 30px rgba(12, 12, 12, 0.911);
}

.management-card h2{
    color: var(--accent);
    margin-bottom:15px;
}

.management-card p{
    color: var(--text-secondary);
    line-height:1.8;
    margin-bottom:25px;
}

.management-card a{
    text-decoration:none;
}

.management-card button{
    padding:12px 24px;
    border:none;
    border-radius:10px;
    background: var(--accent);
    color:white;
    font-weight:600;
    cursor:pointer;
    transition:0.3s;
}

.management-card button:hover{
    background: var(--accent-hover);
    transform: translateY(-2px);
}

/* FOOTER */

        footer{
            padding:30px;
            text-align:center;
            border-top:1px solid var(--border);
            color: var(--text-secondary);
            margin-top:50px;
            background-color:black ;
        }

/* RESPONSIVE */

@media(max-width:900px){

    .overview{
        grid-template-columns: repeat(2, 1fr);
    }

    .management-grid{
        grid-template-columns: 1fr;
    }
}

@media(max-width:600px){

    .overview{
        grid-template-columns: 1fr;
    }

    .header{
        flex-direction:column;
        gap:20px;
    }
}

</style>
</head>
<body>
    <!-- HEADER -->

    <header>

        <div class="logo"><u>Velvet Bites</u></div>

        <nav>
            <ul>
                <form action="/logout" method="POST" style="display:inline;">
                        <button type="submit" class="button">Logout</button>
                 </form>
            </ul>
        </nav>

    </header>
    <!--OVERVIEW-->
<div class="overview">

    <div class="overview-card">
        <h2>Total Users</h2>
        <p><%= totalUsers || 0 %></p>
    </div>

     <div class="overview-card">
        <h2>Total Order</h2>
        <p><%= totalOrders || 0 %></p>
    </div>

    <div class="overview-card">
        <h2>Total Revenue</h2>
        <p><%= totalRevenue || 0 %></p>
    </div>

    <div class="overview-card">
        <h2>Menu Items</h2>
        <p><%= totalMenuItems || 0 %></p>
    </div>


</div>
    <!--MANAGEMENT-->
    <div class="management-grid">

      <div class="management-card">
             <h2>STAFF MANAGEMENT</h2><br>
             <p> Add, modify, delete, and manage all staff members 
        while monitoring staff access and responsibilities.</p><br>
            <a href="/staff"> <button class="button"> View</button></a>
      </div>

     <div class="management-card">
             <h2>ORDER MANAGEMENT</h2><br>
             <p>View all customer orders, order details,
            and monitor order activities.</p><br>
            <a href="/order"> <button class="button"> View</button></a>
      </div>

      <div class="management-card">
             <h2>USER MANAGEMENT</h2><br>
             <p> Handle all registered users currently using the website,
              including both customer and admin accounts.</p><br>
            <a href="/user"> <button class="button"> View</button></a>
      </div>
      </div>

    <!-- FOOTER -->

    <footer>
        © 2026 Velvet Bites | Crafted With Love ☕
    </footer>


    
</body>
</html>